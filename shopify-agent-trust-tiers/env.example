# このファイルを .env にコピーして値を入れる。.env はコミットしない

# 検証先のストア(自分の開発用ストア)。https:// は付けない
SHOP_DOMAIN=your-dev-store.myshopify.com

# カートに入れる商品バリアントの GID
VARIANT_ID=gid://shopify/ProductVariant/0000000000000

# 見積もりに使う国コード
ADDRESS_COUNTRY=JP

# エージェントの UCP プロフィールの URL。未設定なら Shopify が公開している例を使う
# Signed で名乗るときは、gen-key で作ったプロフィールを自分で公開した URL を入れる
AGENT_PROFILE_URL=

# Signed 用。pnpm gen-key が出力する秘密鍵(JWK を 1 行の JSON で)
UCP_SIGNING_KEY_JWK=

# Token 用。Dev Dashboard の Catalogs で発行した API キー
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Token 用。買い手の IP アドレス(検証では自分の IP)。無いと Token の呼び出しは 422 で弾かれる
BUYER_IP=
